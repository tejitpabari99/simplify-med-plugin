{
  "name": "simplify-med-openai-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:validator": "node scripts/generate-validator.mjs",
    "build:ui": "npm run build:validator && esbuild ui/src/report-viewer.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=ui/dist/report-viewer.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:ui && npm run build:server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
