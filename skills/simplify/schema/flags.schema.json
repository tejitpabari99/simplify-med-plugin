{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "flags",
  "type": "object",
  "required": ["schema_version", "plugin_version", "run_id", "numeric_parity", "thin_fields"],
  "additionalProperties": false,
  "definitions": {
    "numeric_parity_item": {
      "type": "object",
      "required": ["flag_id", "path", "tokens_in_field", "tokens_in_facts"],
      "additionalProperties": false,
      "properties": {
        "flag_id": {"type": "integer", "minimum": 1},
        "path": {"type": "string"},
        "tokens_in_field": {"type": "array", "items": {"type": "string"}},
        "tokens_in_facts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "thin_field_item": {
      "type": "object",
      "required": ["path", "value"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "value": {"type": "string"}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string", "enum": ["2.0"]},
    "plugin_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "numeric_parity": {"type": "array", "items": {"$ref": "#/definitions/numeric_parity_item"}},
    "thin_fields": {"type": "array", "items": {"$ref": "#/definitions/thin_field_item"}}
  }
}
