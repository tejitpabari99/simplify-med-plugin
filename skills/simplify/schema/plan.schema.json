{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan",
  "description": "Structured output of the simplify skill. Used only when the user asks for structured output (JSON); never read during writing or verification. Same shape as the internal draft in stages/write.md. Every visible item carries 1-3 short verbatim evidence quotes from the source.",
  "type": "object",
  "required": [
    "schema_version",
    "visit_type",
    "why_you_went",
    "findings_lead",
    "findings",
    "diagnoses",
    "disposition",
    "next_steps",
    "medicines",
    "return_precautions",
    "questions",
    "must_keep"
  ],
  "additionalProperties": false,
  "definitions": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statement": {
      "type": "object",
      "required": [
        "text",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "name",
        "result",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": [
        "name",
        "plain_name",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "plain_name": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        }
      }
    },
    "medicine": {
      "type": "object",
      "required": [
        "name",
        "change",
        "text",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "type": "string",
          "enum": [
            "start",
            "stop",
            "change",
            "continue",
            "instruction"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "question",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        }
      }
    },
    "must_keep_status": {
      "type": "string",
      "enum": [
        "shown",
        "none_in_source"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "4.0"
      ]
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "er_visit",
        "urgent_care",
        "hospital_stay",
        "clinic_visit",
        "test_results",
        "procedure",
        "other"
      ]
    },
    "why_you_went": {
      "$ref": "#/definitions/statement"
    },
    "findings_lead": {
      "anyOf": [
        {
          "$ref": "#/definitions/statement"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "diagnoses": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/diagnosis"
      }
    },
    "disposition": {
      "anyOf": [
        {
          "$ref": "#/definitions/statement"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_steps": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/statement"
      }
    },
    "medicines": {
      "type": "object",
      "required": [
        "items",
        "none_statement"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/medicine"
          }
        },
        "none_statement": {
          "anyOf": [
            {
              "$ref": "#/definitions/statement"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "return_precautions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/statement"
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/question"
      }
    },
    "must_keep": {
      "type": "object",
      "required": [
        "medication_changes",
        "follow_up",
        "return_precautions",
        "diagnoses",
        "disposition",
        "abnormal_or_pending_results"
      ],
      "additionalProperties": false,
      "properties": {
        "medication_changes": {
          "$ref": "#/definitions/must_keep_status"
        },
        "follow_up": {
          "$ref": "#/definitions/must_keep_status"
        },
        "return_precautions": {
          "$ref": "#/definitions/must_keep_status"
        },
        "diagnoses": {
          "$ref": "#/definitions/must_keep_status"
        },
        "disposition": {
          "$ref": "#/definitions/must_keep_status"
        },
        "abnormal_or_pending_results": {
          "$ref": "#/definitions/must_keep_status"
        }
      }
    }
  }
}
