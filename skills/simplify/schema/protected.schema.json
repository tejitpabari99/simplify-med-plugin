{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "protected",
  "description": "Protected-content candidate units found by scripts/protected.py (01_protected.json).",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "3.0"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "object",
      "required": [
        "medication_changes",
        "follow_up",
        "return_precautions",
        "diagnoses",
        "disposition",
        "abnormal_or_pending_results"
      ],
      "additionalProperties": false,
      "properties": {
        "medication_changes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "follow_up": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "return_precautions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "diagnoses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "disposition": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "abnormal_or_pending_results": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
