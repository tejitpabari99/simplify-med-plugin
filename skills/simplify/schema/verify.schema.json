{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verify",
  "description": "Settled verification record (03_verify.json; round 2: 03_verify.r2.json) written by settle.py: the accepted claims, applied operations, numeric resolutions, protected-unit decisions, and the numeric tokens the verifier accepted as equivalent (at their settled paths).",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "round",
    "outcome",
    "claims",
    "operations",
    "numeric_resolutions",
    "protected_units",
    "accepted_numeric",
    "missing",
    "counts"
  ],
  "additionalProperties": false,
  "definitions": {
    "unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "category": {
      "type": "string",
      "enum": [
        "medication_changes",
        "follow_up",
        "return_precautions",
        "diagnoses",
        "disposition",
        "abnormal_or_pending_results"
      ]
    }
  },
  "properties": {
    "schema_version": {"type": "string", "enum": ["3.0"]},
    "run_id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1, "maximum": 2},
    "outcome": {"type": "string", "enum": ["settled", "repair_requested", "missing_after_repair"]},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "result"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["supported", "needs_correction", "unsupported"]},
          "note": {"type": "string"}
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": ["op", "path", "value", "unit_ids"],
            "additionalProperties": false,
            "properties": {
              "op": {"type": "string", "enum": ["replace"]},
              "path": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "unit_ids": {"$ref": "#/definitions/unit_ids"}
            }
          },
          {
            "type": "object",
            "required": ["op", "path"],
            "additionalProperties": false,
            "properties": {
              "op": {"type": "string", "enum": ["clear"]},
              "path": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "required": ["op", "path", "reason"],
            "additionalProperties": false,
            "properties": {
              "op": {"type": "string", "enum": ["remove"]},
              "path": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "enum": ["unsupported", "noise", "duplicate"]}
            }
          }
        ]
      }
    },
    "numeric_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag_id", "resolution"],
        "additionalProperties": false,
        "properties": {
          "flag_id": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "enum": ["equivalent", "corrected", "removed"]},
          "correction_path": {"type": "string"}
        }
      }
    },
    "protected_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "result"],
        "additionalProperties": false,
        "properties": {
          "unit_id": {"type": "integer", "minimum": 1},
          "result": {"type": "string", "enum": ["covered", "not_needed", "missing"]},
          "reason": {
            "type": "string",
            "enum": ["boilerplate", "duplicate", "superseded", "not_patient_specific", "false_positive"]
          },
          "category": {"$ref": "#/definitions/category"}
        }
      }
    },
    "accepted_numeric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "token"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "token": {"type": "string", "minLength": 1}
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "category"],
        "additionalProperties": false,
        "properties": {
          "unit_id": {"type": "integer", "minimum": 1},
          "category": {"$ref": "#/definitions/category"}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "claims",
        "supported",
        "needs_correction",
        "unsupported",
        "operations",
        "numeric_flags",
        "protected_units",
        "missing",
        "word_count_before",
        "word_count_after"
      ],
      "additionalProperties": false,
      "properties": {
        "claims": {"type": "integer", "minimum": 0},
        "supported": {"type": "integer", "minimum": 0},
        "needs_correction": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "operations": {"type": "integer", "minimum": 0},
        "numeric_flags": {"type": "integer", "minimum": 0},
        "protected_units": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "word_count_before": {"type": "integer", "minimum": 0},
        "word_count_after": {"type": "integer", "minimum": 0}
      }
    }
  }
}
