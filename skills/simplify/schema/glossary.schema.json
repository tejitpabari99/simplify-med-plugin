{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "glossary",
  "type": "object",
  "required": ["schema_version", "plugin_version", "run_id", "terms"],
  "additionalProperties": false,
  "definitions": {
    "term": {
      "type": "object",
      "required": ["term", "matched_term", "definition", "source"],
      "additionalProperties": false,
      "properties": {
        "term": {"type": "string"},
        "matched_term": {"type": "string"},
        "definition": {"type": "string"},
        "source": {"type": "string", "enum": ["llm_proposed"]}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string"},
    "plugin_version": {"type": "string"},
    "run_id": {"type": "string"},
    "terms": {"type": "array", "items": {"$ref": "#/definitions/term"}}
  }
}
