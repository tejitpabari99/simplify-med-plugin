{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review",
  "type": "object",
  "required": [
    "schema_version",
    "plugin_version",
    "run_id",
    "reviewed_fact_ids",
    "fact_reviews",
    "corrections",
    "numeric_resolutions",
    "reassemble_fact_ids",
    "dropped_operations",
    "counts",
    "verdict"
  ],
  "additionalProperties": false,
  "definitions": {
    "fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "fact_review": {
      "type": "object",
      "required": ["fact_id", "result"],
      "additionalProperties": false,
      "properties": {
        "fact_id": {"type": "integer", "minimum": 1},
        "result": {
          "type": "string",
          "enum": [
            "visible_accurate",
            "visible_needs_correction",
            "omission_acceptable",
            "must_include"
          ]
        }
      }
    },
    "correction": {
      "anyOf": [
        {
          "type": "object",
          "required": ["op", "path", "value", "source_fact_ids"],
          "additionalProperties": false,
          "properties": {
            "op": {"type": "string", "enum": ["replace"]},
            "path": {"type": "string", "minLength": 1},
            "value": {"anyOf": [{"type": "string"}, {"type": "null"}]},
            "source_fact_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "additionalProperties": false,
          "properties": {
            "op": {"type": "string", "enum": ["clear", "remove"]},
            "path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "numeric_resolution": {
      "anyOf": [
        {
          "type": "object",
          "required": ["flag_id", "resolution"],
          "additionalProperties": false,
          "properties": {
            "flag_id": {"type": "integer", "minimum": 1},
            "resolution": {"type": "string", "enum": ["equivalent"]}
          }
        },
        {
          "type": "object",
          "required": ["flag_id", "resolution", "correction_path"],
          "additionalProperties": false,
          "properties": {
            "flag_id": {"type": "integer", "minimum": 1},
            "resolution": {"type": "string", "enum": ["corrected", "removed"]},
            "correction_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "dropped_operation": {
      "type": "object",
      "required": ["operation", "reason"],
      "additionalProperties": false,
      "properties": {
        "operation": {"type": "object"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "facts_reviewed",
        "visible_accurate",
        "visible_needs_correction",
        "omission_acceptable",
        "must_include",
        "corrections",
        "numeric_resolutions",
        "dropped_operations",
        "reassemble_facts"
      ],
      "additionalProperties": false,
      "properties": {
        "facts_reviewed": {"type": "integer", "minimum": 0},
        "visible_accurate": {"type": "integer", "minimum": 0},
        "visible_needs_correction": {"type": "integer", "minimum": 0},
        "omission_acceptable": {"type": "integer", "minimum": 0},
        "must_include": {"type": "integer", "minimum": 0},
        "corrections": {"type": "integer", "minimum": 0},
        "numeric_resolutions": {"type": "integer", "minimum": 0},
        "dropped_operations": {"type": "integer", "minimum": 0},
        "reassemble_facts": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string", "enum": ["2.0"]},
    "plugin_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "reviewed_fact_ids": {"$ref": "#/definitions/fact_ids"},
    "fact_reviews": {"type": "array", "items": {"$ref": "#/definitions/fact_review"}},
    "corrections": {"type": "array", "items": {"$ref": "#/definitions/correction"}},
    "numeric_resolutions": {"type": "array", "items": {"$ref": "#/definitions/numeric_resolution"}},
    "reassemble_fact_ids": {"$ref": "#/definitions/fact_ids"},
    "dropped_operations": {"type": "array", "items": {"$ref": "#/definitions/dropped_operation"}},
    "counts": {"$ref": "#/definitions/counts"},
    "verdict": {"type": "string", "enum": ["pass", "needs_correction", "needs_reassembly"]}
  }
}
