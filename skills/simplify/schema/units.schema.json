{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "units",
  "description": "Every non-blank source line as a numbered unit (01_units.json). Units with `skip` are boilerplate kept for audit; they are left out of 01_source.txt and are never valid citations.",
  "type": "object",
  "required": ["schema_version", "plugin_version", "run_id", "units"],
  "additionalProperties": false,
  "definitions": {
    "unit": {
      "type": "object",
      "required": ["id", "file", "page", "line", "text", "extraction_method"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "file": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "line": {"type": "integer", "minimum": 1},
        "text": {"type": "string"},
        "extraction_method": {"type": "string", "enum": ["native", "ocr", "pasted"]},
        "skip": {"type": "string", "enum": ["url", "page_counter", "repeat"]}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string", "enum": ["3.0"]},
    "plugin_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "units": {"type": "array", "items": {"$ref": "#/definitions/unit"}}
  }
}
