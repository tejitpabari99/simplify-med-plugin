{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verify_raw",
  "description": "Model contract for the VERIFY stage (03_verify.raw.json).",
  "type": "object",
  "required": [
    "claims",
    "operations",
    "numeric_resolutions",
    "protected_units"
  ],
  "additionalProperties": false,
  "definitions": {
    "unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "supported",
              "needs_correction",
              "unsupported"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "op",
              "path",
              "value",
              "unit_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "replace"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "unit_ids": {
                "$ref": "#/definitions/unit_ids"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "clear"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "path",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "remove"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "enum": [
                  "unsupported",
                  "noise",
                  "duplicate"
                ]
              }
            }
          }
        ]
      }
    },
    "numeric_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag_id",
          "resolution"
        ],
        "additionalProperties": false,
        "properties": {
          "flag_id": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "enum": [
              "equivalent",
              "corrected",
              "removed"
            ]
          },
          "correction_path": {
            "type": "string"
          }
        }
      }
    },
    "protected_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "covered",
              "not_needed",
              "missing"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "boilerplate",
              "duplicate",
              "superseded",
              "not_patient_specific",
              "false_positive"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "medication_changes",
              "follow_up",
              "return_precautions",
              "diagnoses",
              "disposition",
              "abnormal_or_pending_results"
            ]
          }
        }
      }
    }
  }
}
