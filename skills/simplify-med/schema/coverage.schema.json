{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "coverage",
  "type": "object",
  "required": ["schema_version", "plugin_version", "run_id", "coverage", "missing"],
  "additionalProperties": false,
  "definitions": {
    "coverage_item": {
      "type": "object",
      "required": ["fact_id", "present"],
      "additionalProperties": false,
      "properties": {
        "fact_id": {"type": "integer", "minimum": 1},
        "present": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string"},
    "plugin_version": {"type": "string"},
    "run_id": {"type": "string"},
    "coverage": {"type": "array", "items": {"$ref": "#/definitions/coverage_item"}},
    "missing": {"type": "array", "items": {"type": "integer"}}
  }
}
