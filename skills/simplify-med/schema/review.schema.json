{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review",
  "type": "object",
  "required": ["schema_version", "plugin_version", "run_id", "verdict", "corrections", "dropped"],
  "additionalProperties": false,
  "definitions": {
    "correction": {
      "type": "object",
      "required": ["op", "path"],
      "additionalProperties": false,
      "properties": {
        "op": {"type": "string", "enum": ["correct", "not_stated", "remove"]},
        "path": {"type": "string"},
        "value": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "dropped_item": {
      "type": "object",
      "required": ["correction", "reason"],
      "additionalProperties": false,
      "properties": {
        "correction": {"type": "object"},
        "reason": {"type": "string"}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string"},
    "plugin_version": {"type": "string"},
    "run_id": {"type": "string"},
    "verdict": {"type": "string", "enum": ["pass", "needs_correction"]},
    "corrections": {"type": "array", "items": {"$ref": "#/definitions/correction"}},
    "dropped": {"type": "array", "items": {"$ref": "#/definitions/dropped_item"}}
  }
}
