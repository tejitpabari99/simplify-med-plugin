{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "manifest",
  "type": "object",
  "required": ["schema_version", "plugin_version", "run_id", "created_at", "level", "inputs"],
  "additionalProperties": false,
  "definitions": {
    "input": {
      "type": "object",
      "required": ["file", "extraction_method", "pages"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "extraction_method": {"type": "string", "enum": ["native", "ocr", "pasted"]},
        "pages": {"type": "integer", "minimum": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string"},
    "plugin_version": {"type": "string"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "level": {"type": "string", "enum": ["standard"]},
    "inputs": {"type": "array", "items": {"$ref": "#/definitions/input"}}
  }
}
